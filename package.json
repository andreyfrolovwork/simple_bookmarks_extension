{
  "name": "vite-svelte-ts-starter",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:extension": "vite build --watch --mode development",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "pack": "cd dist && zip -r ../bookmark-manager.zip . -x '*.map' -x '*.DS_Store' -x '**/.DS_Store'",
    "pack:yandex": "node scripts/pack-yandex.mjs",
    "pack:all": "npm run build && npm run pack && npm run pack:yandex",
    "store:pack": "npm test && npm run pack:all",
    "store:upload": "npx --yes chrome-webstore-upload-cli@4 upload --source bookmark-manager.zip",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/chrome": "^0.0.277",
    "@types/node": "^24.9.1",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.4.49",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "fuse.js": "^7.1.0",
    "pixelarticons": "^1.8.1"
  }
}
